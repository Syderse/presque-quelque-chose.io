{{/*
  Gabarit pour /articles-aleatoires.json
  Ce fichier génère une liste JSON de toutes les pages souhaitées
  pour la fonctionnalité "article aléatoire".
*/}}
{{- $includeSections := (slice "recherches" "solutions-imaginaires" "ondes-pixels") -}}
{{- $pages := where .Site.RegularPages ".Section" "in" $includeSections -}}
{{- $list := slice -}}
{{- range $pages -}}
  {{/* NOTE : On utilise la clé "permalink" pour matcher le JS du index.html */}}
  {{- $list = $list | append (dict "title" .Title "permalink" .RelPermalink) -}}
{{- end -}}
{{- $list | jsonify -}}