{{- /*
    API ENDPOINT : RANDOMIZER
    Format : RANDOMIZER
    Fichier : layouts/index.randomizer.json
*/ -}}
{{- $includeSections := (slice "recherches" "solutions-imaginaires" "ondes-pixels") -}}
{{- $pages := where .Site.RegularPages ".Section" "in" $includeSections -}}
{{- $list := slice -}}
{{- range $pages -}}
  {{- $list = $list | append (dict "title" .Title "permalink" .RelPermalink "section" .Section) -}}
{{- end -}}
{{- $list | jsonify -}}